// Trace Mate — このリポジトリ直下の install.mel はインストール用ではありません。
// 緑の Code → Download ZIP では年号別パッケージを取得できません。
// Releases から Maya 年に合った zip をダウンロードし、その中の install.mel を使ってください。
// https://github.com/matu1004-ctrl/TraceMate/releases/latest

global proc TraceMate_RepoRoot_InstallHint()
{
    string $msg = "Trace Mate の本体は Releases にあります。\n\n"
        + "このファイル（リポジトリ直下の install.mel）ではインストールできません。\n"
        + "緑の Code → Download ZIP は使わず、次を開いてください:\n\n"
        + "https://github.com/matu1004-ctrl/TraceMate/releases/latest\n\n"
        + "Maya 2025 / 2026 / 2027 用の zip から、自分の年を選んでください。";
    confirmDialog
        -title "Trace Mate — Releases から入手してください"
        -message $msg
        -button "OK"
        -defaultButton "OK";
    print ("[TraceMate] " + $msg + "\n");
}

TraceMate_RepoRoot_InstallHint();
